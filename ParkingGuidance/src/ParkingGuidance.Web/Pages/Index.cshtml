@page "/"
@{
    ViewData["Title"] = "Giám sát bãi xe";
}

<span id="liveBadge" class="badge-live badge-live-corner" title="Trạng thái kết nối realtime">● Realtime</span>

<div class="floor-bar">
    <label>Mặt bằng:</label>
    <select id="floorSelect"></select>
    <button id="addFloorBtn" class="btn secondary fb-btn">➕ Thêm mặt bằng</button>
    <button id="renameFloorBtn" class="btn secondary fb-btn">✏️ Đổi tên</button>
    <button id="deleteFloorBtn" class="btn secondary fb-btn">🗑️ Xoá mặt bằng</button>
</div>

<div id="mainSplit" class="main-split">
<section class="panel layout-panel">
    <div class="layout-header">
        <h2>Bản đồ tuỳ chỉnh (Layout Editor)</h2>
        <div class="zoom-box" title="Phóng to / thu nhỏ riêng phần thiết kế (Ctrl + lăn chuột)">
            <label for="zoomSelect">Zoom</label>
            <select id="zoomSelect">
                <option value="0.25">25%</option>
                <option value="0.5">50%</option>
                <option value="0.75">75%</option>
                <option value="1" selected>100%</option>
                <option value="1.5">150%</option>
                <option value="2">200%</option>
                <option value="3">300%</option>
                <option value="4">400%</option>
            </select>
            <button id="zoomOutBtn" type="button" class="btn secondary zoom-btn" title="Thu nhỏ">-</button>
            <button id="zoomInBtn" type="button" class="btn secondary zoom-btn" title="Phóng to">+</button>
        </div>
    </div>

    <div class="layout-toolbar ribbon">
        <div class="ribbon-tabs"><span class="ribbon-tab active">Đồ họa</span></div>
        <div class="ribbon-body">

            <div class="rb-group">
                <div class="rb-items">
                    <button type="button" class="rb-btn large " id="propsToggleBtn" title="Mở / đóng hộp thoại thuộc tính (hoặc nháy đúp vào đối tượng)"><svg class="rb-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/></svg><span>Thuộc tính</span></button>
                    <div class="rb-col">
                        <button type="button" class="rb-btn" id="deleteSelectedBtn" title="Xoá đối tượng đang chọn khỏi bản đồ"><svg class="rb-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 7h14M10 7V5h4v2M7 7l1 12h8l1-12"/></svg><span>Xoá đối tượng</span></button>
                    </div>
                </div>
                <span class="rb-label">Chỉnh sửa</span>
            </div>

            <div class="rb-group">
                <div class="rb-items">
                    <div class="rb-col">
                        <button type="button" class="rb-btn" data-add="Line" title="Đường thẳng: độ dày, màu, nét liền/đứt/chấm, mũi tên, góc xoay"><svg class="rb-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20L20 4"/></svg><span>Đường thẳng</span></button>
                        <button type="button" class="rb-btn" data-add="Rectangle" title="Hình chữ nhật: khung / vùng tô màu, bo góc, chữ bên trong"><svg class="rb-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="6" width="16" height="12"/></svg><span>Hình chữ nhật</span></button>
                        <button type="button" class="rb-btn" data-add="Circle" title="Hình tròn / elip: tô màu, viền, chữ bên trong"><svg class="rb-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="12" rx="8" ry="6"/></svg><span>Hình tròn</span></button>
                    </div>
                </div>
                <span class="rb-label">Hình vẽ</span>
            </div>

            <div class="rb-group">
                <div class="rb-items">
                    <div class="rb-col">
                        <button type="button" class="rb-btn" data-add="Text"><svg class="rb-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 6h14M12 6v13M9 19h6"/></svg><span>Text</span></button>
                        <button type="button" class="rb-btn" data-add="Button" title="Nút ấn: bấm ở chế độ Chạy để chuyển mặt bằng"><svg class="rb-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="9" rx="3"/><path d="M8 12.5h8"/></svg><span>Nút ấn</span></button>
                        <button type="button" class="rb-btn" data-add="Image"><svg class="rb-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1.5"/><circle cx="9" cy="10" r="1.6"/><path d="M4 18l5-5 4 4 3-3 4 4"/></svg><span>Hình ảnh</span></button>
                    </div>
                </div>
                <span class="rb-label">Thành phần</span>
            </div>

            <div class="rb-group">
                <div class="rb-items">
                    <button type="button" class="rb-btn large " data-add="BitLampSwitch" title="Đèn bit / Công tắc bit: hiển thị (và ghi) tag dạng bit — System tag hoặc Project tag Boolean — kèm hình ảnh theo trạng thái"><svg class="rb-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="8" width="19" height="8" rx="4"/><circle cx="16.5" cy="12" r="2.2" fill="currentColor"/></svg><span>Đèn / Công tắc bit</span></button>
                </div>
                <span class="rb-label">Điều khiển</span>
            </div>

            <div class="rb-group">
                <div class="rb-items">
                    <button type="button" class="rb-btn large " data-add="ParkingSlot"><svg class="rb-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="3"/><path d="M10 17V8h3a2.5 2.5 0 010 5h-3"/></svg><span>Vùng nhận diện</span></button>
                    <button type="button" class="rb-btn large " data-add="SlotStats" title="Số chỗ trống, số chỗ có xe, số lỗi không lấy được ảnh"><svg class="rb-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19V11M12 19V5M19 19v-9"/></svg><span>Thống kê chỗ</span></button>
                </div>
                <span class="rb-label">Bãi đỗ</span>
            </div>

            <div id="slotDisplayBar" class="rb-group tb-display">
                <div class="rb-items">
                    <details class="tb-drop">
                        <summary class="rb-btn large" title="Bật/tắt thông tin hiển thị trên mọi vùng nhận diện của tầng"><svg class="rb-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s4-6.5 10-6.5S22 12 22 12s-4 6.5-10 6.5S2 12 2 12z"/><circle cx="12" cy="12" r="2.6"/></svg><span>Thông tin hiển thị ▾</span></summary>
                        <div class="tb-drop-menu">
                            <label class="checkbox-label"><input type="checkbox" data-display="showStatusColor" /> Màu trạng thái</label>
                            <label class="checkbox-label"><input type="checkbox" data-display="showStatusText" /> Chữ trạng thái</label>
                            <label class="checkbox-label"><input type="checkbox" data-display="showPlate" /> Biển số đang đỗ</label>
                            <label class="checkbox-label"><input type="checkbox" data-display="showEntryTime" /> Giờ vào</label>
                            <label class="checkbox-label"><input type="checkbox" data-display="showLastExitPlate" /> Biển xe ra gần nhất</label>
                            <label class="checkbox-label"><input type="checkbox" data-display="showExitTime" /> Giờ ra</label>
                        </div>
                    </details>
                </div>
                <span class="rb-label">Hiển thị vùng</span>
            </div>

            <div class="rb-group">
                <div class="rb-items">
                    <div class="rb-col">
                        <label class="rb-btn file-btn"><svg class="rb-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1.5"/><circle cx="9" cy="10" r="1.6"/><path d="M4 18l5-5 4 4 3-3 4 4"/></svg><span>Chọn ảnh nền</span>
                            <input type="file" id="floorBgInput" accept="image/*" hidden />
                        </label>
                        <button type="button" id="clearBgBtn" class="rb-btn"><svg class="rb-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="M8 9l8 6M16 9l-8 6"/></svg><span>Bỏ ảnh nền</span></button>
                    </div>
                </div>
                <span class="rb-label">Ảnh nền</span>
            </div>

            <div class="rb-group rb-mode">
                <div class="rb-items">
                    <button type="button" class="rb-btn large active" id="buildModeBtn"><svg class="rb-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 6.5a4 4 0 00-5 5L4 17l3 3 5.5-5.5a4 4 0 005-5l-2.5 2.5-2.5-.5-.5-2.5z"/></svg><span>Build</span></button>
                    <button type="button" class="rb-btn large " id="runModeBtn" title="Chạy mặt bằng (nhấn ESC để thoát)"><svg class="rb-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 5l11 7-11 7z" fill="currentColor"/></svg><span>Chạy</span></button>
                </div>
                <span class="rb-label">Chế độ</span>
            </div>

        </div>
    </div>

    <div class="layout-body">
        <div id="layoutViewport" class="layout-viewport">
            <div id="layoutCanvas" class="layout-canvas"></div>
        </div>
    </div>
</section>

</div>

<div id="propsDialog" class="props-dialog" style="display:none;" role="dialog" aria-label="Thuộc tính đối tượng">
    <div id="propsDialogTitle" class="props-dialog-title">
        <span id="propsDialogTitleText">Thuộc tính đối tượng</span>
        <button id="propsDialogClose" type="button" class="props-dialog-close" title="Đóng (Esc)">✕</button>
    </div>
    <aside id="layoutProps" class="layout-props">
        <p class="no-result">Nhấp vào 1 đối tượng trên bản đồ để xem thuộc tính.</p>
    </aside>
</div>

<div id="zonePickModal" class="modal-overlay" style="display:none;">
    <div class="modal-box" style="width:460px;">
        <h3>Thêm vùng nhận diện vào bản đồ</h3>
        <p class="hint small" style="margin-top:0;">
            Danh sách vị trí nhận diện đã vẽ cho camera của <strong>tầng này</strong>, nhóm theo <strong>Zone</strong> (Hệ thống → Camera → Vị trí đỗ). Mỗi số thứ tự chỉ có 1 vị trí trong 1 Zone.
        </p>
        <div id="zonePickList" class="zone-pick-list"></div>
        <div id="zonePickError" class="form-error"></div>
        <div class="prop-actions">
            <button id="zonePickConfirm" class="btn primary">➕ Thêm vào bản đồ</button>
            <button id="zonePickAll" class="btn secondary">Chọn tất cả</button>
            <button id="zonePickCancel" class="btn secondary">Huỷ</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/floors.js"></script>
    <script src="~/js/dashboard.js"></script>
    <script src="~/js/layout.js"></script>
}
