@page
@model ParkingGuidance.Web.Pages.LoginModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Đăng nhập · ParkingGuidance</title>
<style>
  :root {
    --asphalt: #1b2128;
    --panel: #252d36;
    --line: #e8ecef;
    --paint: #f2c230;
    --muted: #9aa6b2;
    --error: #ff8a7a;
    --text: #f3f5f7;
    color-scheme: dark;
  }
  * { box-sizing: border-box; }
  html, body { height: 100%; }
  body {
    margin: 0;
    display: grid;
    place-items: center;
    padding: 24px;
    background: var(--asphalt);
    color: var(--text);
    font-family: Bahnschrift, "Segoe UI Variable", "Segoe UI", system-ui, sans-serif;
  }
  .panel { width: 100%; max-width: 420px; background: var(--panel); border-radius: 6px; padding: 36px 32px 32px; }
  h1 { margin: 0 0 4px; font-size: 30px; font-weight: 600; letter-spacing: .2px; }
  .sub { margin: 0 0 28px; color: var(--muted); font-size: 15px; }

  .row { margin-bottom: 18px; }
  label.field { display: block; margin-bottom: 6px; color: var(--muted); font-size: 14px; }

  input[type=text], input[type=password] {
    width: 100%; height: 46px; padding: 0 14px;
    border: 2px solid #3a4552; border-radius: 4px;
    background: var(--asphalt); color: var(--text);
    font: inherit; font-size: 17px;
  }
  input[type=text]:focus, input[type=password]:focus { outline: none; border-color: var(--paint); }

  /* Combobox tai khoan */
  .combo { position: relative; }
  .combo input { padding-right: 46px; }
  .combo .toggle {
    position: absolute; top: 0; right: 0; width: 46px; height: 46px;
    border: 0; background: transparent; color: var(--muted); cursor: pointer;
    display: grid; place-items: center;
  }
  .combo .toggle:hover { color: var(--text); }
  .combo .toggle:focus-visible { outline: 2px solid var(--paint); outline-offset: -4px; }
  .combo .toggle svg { transition: transform .15s; }
  .combo.open .toggle svg { transform: rotate(180deg); }

  .list {
    position: absolute; z-index: 5; left: 0; right: 0; top: calc(100% + 4px);
    margin: 0; padding: 4px 0; list-style: none;
    background: var(--panel); border: 2px solid #3a4552; border-radius: 4px;
    box-shadow: 0 8px 24px rgba(0,0,0,.45);
  }
  .list[hidden] { display: none; }
  .list li {
    padding: 11px 14px 11px 16px; font-size: 17px; cursor: pointer;
    border-left: 4px solid transparent;
  }
  .list li:hover, .list li.active { background: rgba(242,194,48,.10); border-left-color: var(--paint); color: var(--paint); }

  .error { min-height: 22px; margin: 0 0 14px; color: var(--error); font-size: 14px; }

  button.submit {
    width: 100%; height: 48px; border: 0; border-radius: 4px;
    background: var(--paint); color: #1b2128;
    font: inherit; font-size: 17px; font-weight: 700; cursor: pointer;
  }
  button.submit:hover { filter: brightness(1.06); }
  button.submit:focus-visible { outline: 2px solid var(--line); outline-offset: 3px; }

  @@media (max-width: 420px) { .panel { padding: 28px 20px 24px; } }
</style>
</head>
<body>
  <main class="panel">
    <h1>ParkingGuidance</h1>
    <p class="sub">Nhập hoặc chọn tài khoản, rồi nhập mật khẩu để vào hệ thống.</p>

    <form method="post" id="form" autocomplete="off">
      <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

      <div class="row">
        <label class="field" for="account">Tài khoản</label>
        <div class="combo" id="combo">
          <input id="account" name="Account" type="text" value="@Model.Account"
                 role="combobox" aria-expanded="false" aria-controls="accountList" aria-autocomplete="both"
                 autocapitalize="off" spellcheck="false">
          <button type="button" class="toggle" id="toggle" tabindex="-1" aria-label="Mở danh sách tài khoản">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M2 4.5 7 9.5 12 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <ul class="list" id="accountList" role="listbox" hidden></ul>
        </div>
      </div>

      <div class="row">
        <label class="field" for="password">Mật khẩu</label>
        <input id="password" name="Password" type="password" autocomplete="current-password" autofocus>
      </div>

      <p class="error" id="error" role="alert">@Model.Error</p>
      <button class="submit" type="submit">Đăng nhập</button>
    </form>
  </main>

<script>
(function () {
  // Danh sach hien trong combobox. Tai khoan DEV khong nam o day nhung van dang nhap duoc khi go ten.
  var ACCOUNTS = ['User', 'Megatech'];

  var combo = document.getElementById('combo');
  var input = document.getElementById('account');
  var list = document.getElementById('accountList');
  var toggle = document.getElementById('toggle');
  var pw = document.getElementById('password');
  var err = document.getElementById('error');
  var form = document.getElementById('form');
  var active = -1;

  function prefixMatches(v) {
    v = v.trim().toLowerCase();
    return ACCOUNTS.filter(function (a) { return a.toLowerCase().indexOf(v) === 0; });
  }

  function render(items) {
    list.innerHTML = '';
    items.forEach(function (name, i) {
      var li = document.createElement('li');
      li.setAttribute('role', 'option');
      li.id = 'acc-' + i;
      li.textContent = name;
      // mousedown de chon truoc khi input bi mat focus
      li.addEventListener('mousedown', function (e) { e.preventDefault(); choose(name); });
      list.appendChild(li);
    });
    active = -1;
  }

  function open(items) {
    if (!items.length) { close(); return; }
    render(items);
    list.hidden = false;
    combo.classList.add('open');
    input.setAttribute('aria-expanded', 'true');
  }

  function close() {
    list.hidden = true;
    combo.classList.remove('open');
    input.setAttribute('aria-expanded', 'false');
    input.removeAttribute('aria-activedescendant');
    active = -1;
  }

  function setActive(i) {
    var items = list.children;
    if (!items.length) return;
    active = (i + items.length) % items.length;
    for (var k = 0; k < items.length; k++) items[k].classList.toggle('active', k === active);
    input.setAttribute('aria-activedescendant', items[active].id);
  }

  function choose(name) {
    input.value = name;
    err.textContent = '';
    close();
    pw.focus();
  }

  // Go chu cai -> tu dong dien tai khoan khop (phan con lai duoc boi den, go tiep hoac Backspace de sua)
  input.addEventListener('input', function (e) {
    err.textContent = '';
    var v = input.value;
    var deleting = e.inputType && e.inputType.indexOf('delete') === 0;
    var m = v ? prefixMatches(v) : ACCOUNTS.slice();

    if (!deleting && v && m.length === 1 && m[0].length > v.length) {
      input.value = m[0];
      input.setSelectionRange(v.length, m[0].length);
    }
    var exact = m.length === 1 && m[0].toLowerCase() === input.value.trim().toLowerCase();
    if (exact) close(); else open(m);
  });

  input.addEventListener('keydown', function (e) {
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      if (list.hidden) open(ACCOUNTS.slice());
      setActive(active < 0 ? (e.key === 'ArrowDown' ? 0 : -1) : active + (e.key === 'ArrowDown' ? 1 : -1));
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (!list.hidden && active >= 0) choose(list.children[active].textContent);
      else { close(); pw.focus(); }
    } else if (e.key === 'Escape') {
      close();
    }
  });

  input.addEventListener('focus', function () { input.select(); });
  input.addEventListener('blur', close);

  toggle.addEventListener('mousedown', function (e) {
    e.preventDefault();
    if (list.hidden) { input.focus(); open(ACCOUNTS.slice()); } else close();
  });

  form.addEventListener('submit', function (e) {
    var v = input.value.trim();
    if (!v) {
      e.preventDefault();
      err.textContent = 'Chọn hoặc nhập tên tài khoản.';
      input.focus();
      return;
    }
    // Neu go dang do (vd "meg") thi quy ve tai khoan duy nhat khop
    var m = prefixMatches(v);
    if (m.length === 1) input.value = m[0]; else input.value = v;
  });

  // Mo trang: de san o Mat khau (da autofocus); chon tai khoan thi bam vao o hoac go chu cai
})();
</script>
</body>
</html>
