                    <line x1="440" y1="304" x2="440" y2="316" stroke="#60a5fa" stroke-width="1.5"/>
                    <rect x="384" y="316" width="112" height="26" rx="13" fill="#0a1226" stroke="#60a5fa" stroke-width="1.5"/>
