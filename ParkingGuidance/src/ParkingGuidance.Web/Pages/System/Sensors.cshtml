                <g class="g-manual">
                    <line x1="130" y1="72" x2="151" y2="43" stroke="#34d399" stroke-width="1" stroke-dasharray="3 3"/>
                    <line x1="440" y1="296" x2="461" y2="267" stroke="#34d399" stroke-width="1" stroke-dasharray="3 3"/>
