                <path d="M393,182 L393,248" stroke="#7c2d12" stroke-width="1.5" fill="none"/>
                <rect x="404" y="234" width="22" height="4" rx="2" fill="#7c2d12"/>
                <path d="M171,243 L190,239 L190,250 L171,252 Z" fill="#fde68a"/>
                <rect x="544" y="236" width="8" height="11" rx="2" fill="#ef4444"/>
                <g>
                    <circle cx="236" cy="270" r="31" fill="#0a1226"/>
                    <circle cx="236" cy="270" r="25" fill="#111827"/>
                    <circle cx="236" cy="270" r="15" fill="#94a3b8"/>
                    <circle cx="236" cy="270" r="9" fill="#475569"/>
                    <circle cx="236" cy="270" r="3" fill="#cbd5e1"/>
                    <circle cx="486" cy="270" r="31" fill="#0a1226"/>
                    <circle cx="486" cy="270" r="25" fill="#111827"/>
                    <circle cx="486" cy="270" r="15" fill="#94a3b8"/>
                    <circle cx="486" cy="270" r="9" fill="#475569"/>
                    <circle cx="486" cy="270" r="3" fill="#cbd5e1"/>
                </g>
                <polygon points="516,296 538,296 538,283" fill="#475569"/>

                <!-- Trục đo tới mặt đất -->
                <line x1="130" y1="72" x2="440" y2="296" stroke="#0a1226" stroke-width="5" stroke-linecap="round" opacity=".6"/>
                <line x1="130" y1="72" x2="440" y2="296" stroke="#60a5fa" stroke-width="2" stroke-linecap="round"/>

