@page "/System/Sensors"
@{
    ViewData["Title"] = "Cảm biến";
}

<div class="page-header">
    <h1><span data-i18n="nav.device">Thiết bị</span> — <span data-i18n="nav.sen">Cảm biến</span></h1>
</div>

<div class="source-tabs">
    <button class="tab-btn active" data-tab="cfg">⚙️ Cấu hình</button>
    <button class="tab-btn" data-tab="mon">📡 Giám sát</button>
    <button class="tab-btn" data-tab="data">📊 Dữ liệu</button>
    <button class="tab-btn" data-tab="test">🔍 Thử khung dữ liệu</button>
</div>

<!-- =============== TAB 1: Cấu hình — Loại cảm biến + cài đặt kết nối =============== -->
<div id="cfgTab" class="sys-tab-panel active">
<!-- =============== Loại cảm biến + cài đặt kết nối =============== -->
<section class="panel">
    <h2>Loại cảm biến</h2>
    <div class="sn-types">
        <label class="sn-type"><input type="radio" name="SensorType" value="Pm200" checked />
            <span><b>MGT200</b> <small>(mặc định)</small><br /><small>PC kết nối tới converter và hỏi lần lượt từng ZCU (tối đa 32 ZCU × 160 cảm biến).</small></span></label>
        <label class="sn-type"><input type="radio" name="SensorType" value="Keytop" />
            <span><b>Keytop</b><br /><small>PC mở server TCP, các Keytop tự gửi trạng thái tới (tối đa 85 Keytop × 60 cảm biến).</small></span></label>
    </div>

    <div id="pm200Box" class="sn-box">
        <div class="sn-row">
            <div class="prop-field"><label for="Pm200Ip">IP converter MGT200</label><input id="Pm200Ip" type="text" maxlength="15" placeholder="192.168.0.7" /></div>
            <div class="prop-field"><label for="Pm200Port">Port converter</label><input id="Pm200Port" type="number" min="1" max="65535" placeholder="8888" /></div>
            <div class="prop-field"><label for="Pm200Wait">Chờ trả lời tối đa (ms)</label><input id="Pm200Wait" type="number" min="100" max="2000" step="50" title="Thời gian chờ ZCU trả lời sau mỗi lệnh hỏi (100–2000 ms)" /></div>
        </div>
        <div class="sn-sub">Kích hoạt ZCU (chỉ ZCU được tích mới được quét)
            <button id="SnAll" type="button" class="btn secondary btn-sm">Chọn hết</button>
            <button id="SnNone" type="button" class="btn secondary btn-sm">Bỏ hết</button>
        </div>
        <div id="zcuEnable" class="sn-enable"></div>
    </div>

    <div id="keytopBox" class="sn-box" style="display:none">
        <div class="sn-row">
            <div class="prop-field"><label for="KeytopPort">Port server (PC lắng nghe)</label><input id="KeytopPort" type="number" min="1" max="65535" placeholder="7777" /></div>
            <div class="prop-field"><label for="KeytopIp0">IP của Keytop đầu tiên (ZCU0)</label><input id="KeytopIp0" type="text" maxlength="15" placeholder="192.168.0.100" /></div>
            <div class="prop-field"><label for="KeytopCount">Số lượng Keytop (1–85)</label><input id="KeytopCount" type="number" min="1" max="85" /></div>
            <div class="prop-field"><label for="KeytopTimeout">Timeout mất kết nối (giây)</label><input id="KeytopTimeout" type="number" min="5" max="3600" title="Quá thời gian này không nhận được dữ liệu từ 1 Keytop thì coi là mất kết nối" /></div>
        </div>
        <div class="hint small">Số thứ tự Keytop = octet cuối của IP thiết bị gửi tới trừ octet cuối của IP ZCU0 (cùng dải /24). Ví dụ ZCU0 = 192.168.0.100 thì thiết bị 192.168.0.102 là ZCU 2.</div>
    </div>

    <div class="sn-actions">
        <button id="SnSave" class="btn primary btn-sm"><span class="ico">💾</span> Lưu cài đặt</button>
        <span id="SnSaveState" class="hint small"></span>
    </div>
    <div class="hint small">Lưu xong có hiệu lực ngay: chương trình tự đóng kết nối cũ và kết nối lại theo cài đặt mới.</div>
</section>

</div>

<!-- =============== TAB 2: Giám sát — trạng thái từng ZCU / cảm biến + Cài đặt cảm biến MGT200 =============== -->
<div id="monTab" class="sys-tab-panel">
<!-- =============== Giám sát =============== -->
<section class="panel">
    <h2>Giám sát</h2>
    <div id="snConn" class="sn-conn"></div>
    <div id="snTotals" class="sn-totals"></div>

    <div id="snDevices" class="sn-devices"></div>

    <div id="snDetail" class="sn-detail">
        <div id="snDetailHead" class="sn-detail-head"></div>
        <div id="snGrid" class="sn-grid"></div>
        <div class="sn-legend">
            <span><i class="sn-cell s0"></i>Trống</span>
            <span><i class="sn-cell s1"></i>Có xe</span>
            <span><i class="sn-cell s2"></i>Lỗi</span>
            <span><i class="sn-cell sU"></i>Chưa có dữ liệu</span>
            <span><i class="sn-cell off"></i>Mất kết nối</span>
        </div>
        <div id="snFrame" class="sn-frame"></div>
    </div>
</section>

<!-- =============== Cài đặt cảm biến MGT200 (PM200Setting › Cài đặt cảm biến) =============== -->
<section id="cmdPanel" class="panel" style="display:none">
    <h2>Cài đặt cảm biến MGT200</h2>
    <div class="sn-cmdlayout">
        <div class="sn-cmdform">
    <div class="sn-row">
            <div class="prop-field"><label for="CmdZcu">Chọn ZCU</label><select id="CmdZcu"></select></div>
            <div class="prop-field"><label for="CmdCommand">Chọn lệnh</label><select id="CmdCommand"></select></div>
            <div class="prop-field"><label for="CmdChannel">Chọn Line</label><select id="CmdChannel"></select></div>
            <div id="CmdSensorWrap" class="prop-field"><label for="CmdSensor">Chọn cảm biến</label><select id="CmdSensor"></select></div>
            <div id="CmdDataWrap" class="prop-field" style="display:none"><label id="CmdDataLabel" for="CmdData">Dữ liệu</label><select id="CmdData"></select></div>
        </div>
        <div id="CmdHint" class="hint small" style="margin-top:0"></div>

        <div class="sn-actions">
            <button id="CmdRun" class="btn primary btn-sm"><span class="ico">▶️</span> Thực hiện</button>
            <label id="CmdAutoWrap" class="sn-en" style="display:none"><input id="CmdAuto" type="checkbox" /> Đọc liên tục</label>
            <span id="CmdState" class="hint small"></span>
        </div>
        </div>
