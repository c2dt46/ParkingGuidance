                <ellipse cx="362" cy="299" rx="214" ry="5" fill="#000" opacity=".35"/>
                <path d="M170,270 L170,248 C170,240 178,236 190,234 L232,226 C262,198 292,176 340,174 L440,174 C478,174 506,198 520,216 L540,222 C548,224 552,234 552,248 L552,270 Z" fill="url(#figCar)"/>
