                <rect x="48" y="22" width="544" height="10" rx="2" fill="#64748b"/>
                <rect x="582" y="22" width="10" height="278" fill="#64748b"/>
                <rect x="48" y="296" width="544" height="6" rx="2" fill="url(#figFloor)"/>

                <!-- Cảm biến treo trần -->
                <line x1="130" y1="32" x2="130" y2="54" stroke="#94a3b8" stroke-width="2"/>
                <rect x="110" y="54" width="40" height="15" rx="4" fill="#475569" stroke="#94a3b8" stroke-width="1"/>
                <ellipse cx="130" cy="72" rx="15" ry="7" fill="#1e293b" stroke="#94a3b8" stroke-width="1"/>
                <circle cx="130" cy="72" r="4" fill="#ef4444"/>
                <line x1="130" y1="78" x2="130" y2="296" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="5 5" opacity=".75"/>

