                    <linearGradient id="figCar" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ff8a3d"/><stop offset=".55" stop-color="#ea580c"/><stop offset="1" stop-color="#b43c08"/></linearGradient>
                    <linearGradient id="figGlass" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#cbd5e1"/><stop offset="1" stop-color="#64748b"/></linearGradient>
