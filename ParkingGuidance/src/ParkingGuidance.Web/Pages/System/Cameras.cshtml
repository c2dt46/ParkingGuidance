@page "/System/Cameras"
@{
    ViewData["Title"] = "Quản lý Camera";
}

<div class="page-header">
    <h1><span data-i18n="nav.device">Thiết bị</span> — <span data-i18n="nav.cam">Camera</span></h1>
</div>

<div class="source-tabs">
    <button class="tab-btn active" data-tab="list">📋 Danh sách</button>
    <button class="tab-btn" data-tab="zones">🎯 Vị trí đỗ</button>
    <button class="tab-btn" data-tab="config">⚙️ Cấu hình chung</button>
    <button class="tab-btn" data-tab="data">📊 Dữ liệu</button>
    <button class="tab-btn" data-tab="log">🕘 Lịch sử</button>
    <button class="tab-btn" data-tab="sim">🧪 Mô phỏng</button>
    <button class="tab-btn" data-tab="trainhub">🧠 Train</button>
</div>

<div id="listTab" class="sys-tab-panel active">

    <section class="panel">
        <h2>Dò tìm camera trên mạng</h2>
        <p class="hint">
            Chọn hãng camera đang dùng trong hệ thống rồi bấm <strong>"Quét lại"</strong> để dò tìm
            camera hãng đó trên mạng LAN (qua chuẩn ONVIF). Không tự động quét lại — chỉ quét khi bạn bấm nút.
        </p>

        <div class="camera-toolbar">
            <select id="brandSelect"></select>
            <button id="scanBtn" class="btn primary">🔄 Quét lại</button>
            <button id="addCameraBtn" class="btn secondary">➕ Thêm camera (theo IP)</button>
        </div>

        <div id="scanStatus" class="hint small"></div>

        <table class="data-table" id="scanTable">
            <thead>
                <tr><th>IP</th><th>Cổng</th><th>Hãng phát hiện</th><th>Model</th><th>Trạng thái</th><th></th></tr>
            </thead>
            <tbody id="scanResultsBody">
                <tr><td colspan="6" class="no-result">Chưa quét — chọn hãng rồi bấm "Quét lại".</td></tr>
            </tbody>
        </table>
    </section>

    <section class="panel">
        <h2>Camera trong hệ thống</h2>
        <p class="hint">
            Nhấp vào 1 dòng để gán <strong>tầng hầm</strong> và <strong>Zone</strong> (khu vực lắp đặt trong tầng), ghi <strong>chú thích</strong>, rồi bấm
            <strong>"Thêm vào hệ thống bãi đỗ"</strong> — từ lúc đó camera mới được dùng cho các thao
            tác giám sát/nhận diện về sau.
        </p>

        <table class="data-table" id="registryTable">
            <thead>
                <tr><th>IP</th><th>Hãng / Model</th><th>Tầng hầm</th><th>Zone</th><th>Trạng thái</th><th></th></tr>
            </thead>
            <tbody id="registryBody">
                <tr><td colspan="6" class="no-result">Chưa có camera nào trong danh sách.</td></tr>
            </tbody>
        </table>
    </section>

    <div id="cameraDetailPanel" class="camera-detail" style="display:none;"></div>

    <div id="addCameraModal" class="modal-overlay" style="display:none;">
        <div class="modal-box">
            <h3>Thêm camera theo IP</h3>
            <div class="prop-field"><label>Địa chỉ IP</label><input id="newCamIp" type="text" placeholder="192.168.1.64" /></div>
            <div class="prop-field"><label>Cổng</label><input id="newCamPort" type="number" value="80" /></div>
            <div class="prop-field">
                <label>Hãng</label>
                <select id="newCamBrand"></select>
            </div>
            <div class="prop-field"><label>Model (tuỳ chọn)</label><input id="newCamModel" type="text" /></div>
            <div id="addCameraError" class="form-error"></div>
            <div class="prop-actions">
                <button id="confirmAddCameraBtn" class="btn primary">➕ Thêm</button>
                <button id="cancelAddCameraBtn" class="btn secondary">Huỷ</button>
            </div>
        </div>
    </div>
</div>

<div id="zonesTab" class="sys-tab-panel">
    <section class="panel">
        <h2>Vị trí đỗ — vùng nhận diện theo camera</h2>
        <details class="hint-fold"><summary>ℹ️ Hướng dẫn</summary><p class="hint">
            Chọn 1 camera <strong>đã có trong bãi đỗ</strong> (đã "Thêm vào hệ thống bãi đỗ" ở tab
            Danh sách), xem hình ảnh camera đó chụp (hoặc <strong>mô phỏng</strong> bằng cách chọn 1
            ảnh trên máy tính nếu chưa có camera thật), rồi vẽ các <strong>vùng nhận diện</strong> —
            mỗi vùng ứng với 1 ô đỗ cụ thể. Xe chỉ được tính là đang đỗ ở ô đó khi
            <strong>phần lớn diện tích xe nằm trong vùng</strong>. Mỗi vùng chỉ nhận <strong>tối đa 1 xe</strong>
            (xe chiếm nhiều diện tích trong vùng nhất; xe nhỏ/xa/bị che cùng nằm trong vùng bị bỏ qua), nên số xe nhận được
            không bao giờ vượt quá số vùng. Lõi AI dùng đúng các vùng này khi nhận diện thật.
        </p></details>

        <div class="camera-toolbar">
            <select id="zoneCameraSelect"><option value="">— Chọn camera —</option></select>
        </div>

        <div id="zoneEditorEmpty" class="no-result">Chọn 1 camera ở trên để bắt đầu.</div>

        <div id="zoneEditor" style="display:none;">
            <div class="camera-toolbar">
                <div class="mode-toggle compact">
                    <button id="srcCameraBtn" class="btn secondary btn-sm mode-btn">📷 Lấy từ Camera</button>
                    <button id="srcPcBtn" class="btn secondary btn-sm mode-btn mode-active">📁 Chọn từ PC</button>
                </div>
                <span class="toolbar-sep"></span>
                <label class="btn secondary btn-sm file-btn" id="chooseImageLabel">
                    📁 Chọn ảnh mô phỏng
                    <input type="file" id="zoneImageInput" accept="image/*" hidden />
                </label>
                <button id="drawZoneBtn" class="btn secondary btn-sm">➕ Vẽ vùng mới</button>
                <button id="cancelZoneBtn" class="btn secondary btn-sm" style="display:none;">✕ Huỷ vẽ</button>
                <button id="testDetectBtn" class="btn secondary btn-sm">🔍 Chạy thử nhận diện</button>
                <button id="saveZonesBtn" class="btn primary btn-sm">💾 Lưu vùng nhận diện</button>
            </div>

            <div id="cameraSourceControls" class="camera-toolbar" style="display:none;">
                <button id="captureNowBtn" class="btn secondary btn-sm">📸 Lấy ảnh ngay</button>
                <label class="prop-inline" style="margin-left:6px;">
                    <span class="hint small" style="margin:0;">Tự động lấy mỗi</span>
                    <input id="captureIntervalInput" type="number" min="2" max="600" value="10" style="width:60px;" />
                    <span class="hint small" style="margin:0;">giây</span>
                </label>
                <button id="toggleAutoCaptureBtn" class="btn secondary btn-sm">▶️ Bắt đầu tự động</button>
                <span id="captureStatus" class="hint small"></span>
            </div>

            <div class="camera-toolbar">
                <label class="prop-inline" title="Chỉ áp dụng cho ảnh xem trước trên trang này (khi trang đang mở)">
                    <input id="autoDetectChk" type="checkbox" checked />
                    <span class="hint small" style="margin:0;">Tự động nhận diện khi ảnh mới thay đổi vượt ngưỡng</span>
                </label>
                <label class="prop-inline">
                    <input id="registerChk" type="checkbox" checked />
                    <span class="hint small" style="margin:0;">Ghi nhận kết quả vào bãi đỗ (cập nhật ô đỗ &amp; bản đồ Giám sát)</span>
                </label>
                <span id="autoDetectStatus" class="hint small"></span>
            </div>

            <div class="camera-toolbar">
                <span class="hint small" style="margin:0;" title="Tự động: camera chạy nền liên tục theo vòng lặp (áp dụng ngưỡng bên cạnh), kể cả khi đóng trang này. Thủ công: KHÔNG chạy nền — chỉ nhận diện khi bấm &quot;Nhận diện ngay&quot;.">Chế độ chạy nền ⓘ</span>
                <div class="mode-toggle compact">
                    <button id="modeAutoBtn" class="btn secondary btn-sm mode-btn">🔁 Tự động</button>
                    <button id="modeManualBtn" class="btn secondary btn-sm mode-btn">✋ Thủ công</button>
                </div>
                <button id="detectNowBtn" class="btn primary btn-sm" style="display:none;">▶️ Nhận diện ngay</button>
                <span id="detectNowStatus" class="hint small"></span>
                <span class="toolbar-sep"></span>
                <label class="prop-inline" title="Camera ở chế độ Tự động chỉ chạy AI khi ảnh thay đổi từ mức này trở lên so với khung hình trước (giảm tải khi có nhiều camera). Để trống = dùng mặc định toàn hệ thống.">
                    <span class="hint small" style="margin:0;">Ngưỡng thay đổi ảnh (%)</span>
                    <input id="motionThresholdInput" type="number" min="0" max="100" step="0.5" placeholder="mặc định" style="width:90px;" />
                </label>
                <button id="saveMotionBtn" class="btn secondary btn-sm">💾 Lưu ngưỡng</button>
            </div>

            <div id="drawHint" class="hint small" style="display:none;">
                Đang vẽ vùng: nhấp chuột tại <strong>điểm đầu</strong> của khu vực, kéo tới
                <strong>điểm cuối</strong> rồi thả chuột để hoàn tất.
            </div>

            <div class="zone-workspace">
                <div class="zone-main">
                    <div class="zone-stage-wrap">
                        <div class="camera-stage" id="zoneStage">
                            <img id="zonePreviewImg" alt="Ảnh camera / mô phỏng" />
                            <canvas id="zoneOverlay"></canvas>
                            <div id="zoneStagePlaceholder" class="stage-placeholder">Chưa có ảnh — chọn ảnh mô phỏng ở trên</div>
                        </div>
                    </div>

                    <div id="testDetectResults" class="zone-results"></div>
                </div>

                <aside id="zoneListSide" class="zone-list-side">
                    <h3 class="zone-list-title">
                        <span>Danh sách vùng đã vẽ (<span id="zoneCount">0</span>)</span>
                        <button id="toggleZoneLinesBtn" class="btn secondary btn-sm mode-active" aria-pressed="true" title="Ẩn / hiện đường viền các vùng nhận diện trên ảnh">👁 Vùng: Hiện</button>
                    </h3>
                    <div id="zoneList"></div>
                </aside>
            </div>
        </div>
    </section>
</div>

<div id="configTab" class="sys-tab-panel">
    <p class="hint small">
        Các thông số này được <strong>lưu lại</strong> và có hiệu lực ngay (không cần khởi động lại).
        Camera nào không đặt ngưỡng thay đổi ảnh riêng ở tab Vị trí đỗ sẽ dùng giá trị mặc định ở đây.
    </p>

    <!-- ===== CAMERA ===== -->
    <section class="panel">
        <h2>📷 Camera</h2>
        <div class="settings-grid">
            <div class="prop-field"><label>Chu kỳ lấy ảnh mỗi camera (giây)</label><input id="setInterval" type="number" min="0.5" step="0.5" /></div>
            <div class="prop-field"><label>Ngưỡng thay đổi ảnh mặc định (%)</label><input id="setMotion" type="number" min="0" max="100" step="0.5" /></div>
            <div class="prop-field"><label>Chờ mở kết nối camera tối đa (giây)</label><input id="setOpenTimeout" type="number" min="1" step="1" /></div>
            <div class="prop-field"><label>Chờ lấy 1 khung hình tối đa (giây)</label><input id="setReadTimeout" type="number" min="1" step="1" /></div>
            <div class="prop-field"><label>Camera lỗi: nghỉ tối đa trước khi thử lại (giây)</label><input id="setBackoff" type="number" min="1" step="1" /></div>
            <div class="prop-field"><label>Cảnh báo khi hàng đợi AI chờ quá (giây)</label><input id="setQueueWarn" type="number" min="1" step="1" /></div>
        </div>
    </section>

    <!-- ===== NHẬN DIỆN: xe → biển số → ký tự ===== -->
    <section class="panel">
        <h2>🧠 Nhận diện</h2>

        <div class="settings-block">
            <h3>🚗 Nhận diện xe</h3>
            <div class="settings-grid">
                <div class="prop-field"><label>Độ tin cậy tối thiểu nhận diện xe (0.05 - 0.95)</label><input id="setConf" type="number" min="0.05" max="0.95" step="0.05" /></div>
                <div class="prop-field"><label>Nhận diện xe ô tô (car)</label>
                    <select id="setDetectCar"><option value="1">Có</option><option value="0">Không</option></select></div>
                <div class="prop-field"><label>Nhận diện xe buýt (bus)</label>
                    <select id="setDetectBus"><option value="1">Có</option><option value="0">Không</option></select></div>
                <div class="prop-field"><label>Nhận diện xe tải (truck)</label>
                    <select id="setDetectTruck"><option value="1">Có</option><option value="0">Không</option></select></div>
                <div class="prop-field"><label>Nhận diện xe máy (motorcycle)</label>
                    <select id="setDetectMotorcycle"><option value="1">Có</option><option value="0">Không</option></select></div>
                <div class="prop-field"><label>Xác nhận xe đã rời sau (số lần xử lý liên tiếp không thấy xe)</label><input id="setVacancy" type="number" min="1" max="20" step="1" /></div>
                <div class="prop-field"><label>Cạnh dài tối đa ảnh đưa vào dò xe/biển (px, 0 = ảnh gốc)</label><input id="setProcessMaxSide" type="number" min="0" max="4096" step="64" /></div>
            </div>
        </div>

        <div class="settings-block">
            <h3>🔖 Nhận diện biển số</h3>
            <div class="settings-grid">
                <div class="prop-field"><label>Bộ dò khung biển</label>
                    <select id="setPlateDetector">
                        <option value="0">Tự động (gộp YOLO11n đã train và Darknet)</option>
                        <option value="1">Chỉ YOLO11n đã train (chưa có model thì dùng Darknet)</option>
                        <option value="2">Chỉ Darknet YOLOv3-tiny</option>
                    </select></div>
                <div class="prop-field"><label>Độ tin cậy tối thiểu khung biển số (0.05 - 0.95)</label><input id="setPlateBoxConf" type="number" min="0.05" max="0.95" step="0.05" /></div>
                <div class="prop-field"><label>Biển phải nằm trong khung xe tối thiểu (0 - 1, 0 = tắt)</label><input id="setPlateOverlap" type="number" min="0" max="1" step="0.05" /></div>
                <div class="prop-field"><label>Xe không có khung biển</label>
                    <select id="setPlateFullSearch">
                        <option value="0">Bỏ qua (nhanh)</option>
                        <option value="1">Vẫn tìm biển đầy đủ (chậm, tới vài giây/xe)</option>
                    </select></div>
                <div class="prop-field"><label>Kích thước khung biển số hiển thị</label>
                    <select id="setPlateBoxMode">
                        <option value="0">Giữ nguyên khung theo nhận diện biển số (ôm sát như tab Train + offset)</option>
                        <option value="1">Theo kích thước ký tự (nhận diện ký tự)</option>
                    </select></div>
                <div class="prop-field"><label>Offset khung biển số (% mỗi phía, chỉ áp dụng khi chọn "theo nhận diện biển số"; 0 - 30)</label><input id="setPlateBoxOffset" type="number" min="0" max="30" step="0.5" /></div>
            </div>
        </div>

        <div class="settings-block">
            <h3>🔤 Nhận diện ký tự</h3>
            <div class="settings-grid">
                <div class="prop-field"><label>Kết hợp Tesseract kiểm chứng khi YOLO chưa chắc</label>
                    <select id="setCharCombine">
                        <option value="0">Tắt (chỉ YOLO; Tesseract chỉ dự phòng khi YOLO không đọc được)</option>
                        <option value="1">Bật (Tesseract kiểm chứng khi YOLO chưa chắc)</option>
                    </select></div>
                <div class="prop-field"><label>Độ tin cậy tối thiểu ký tự biển số (0 - 0.95)</label><input id="setCharConf" type="number" min="0" max="0.95" step="0.05" /></div>
                <div class="prop-field"><label>Chiều cao ảnh biển khi đọc ký tự (px, 40 - 300)</label><input id="setPlateReadHeight" type="number" min="40" max="300" step="10" /></div>
            </div>
        </div>
    </section>

    <!-- Nút lưu: sáng khi có thay đổi chưa lưu, tối khi đã lưu hết -->
    <div class="settings-savebar">
        <button id="saveSettingsBtn" class="btn primary save-idle">💾 Lưu cài đặt</button>
        <span id="settingsStatus" class="hint small"></span>
    </div>
    <p class="hint small">Dữ liệu (cài đặt, danh sách camera, vùng nhận diện, mặt bằng, phiên đỗ xe) được lưu tại: <code id="dataDirText">...</code></p>

    <section class="panel">
        <h2>Hàng đợi nhận diện AI &amp; trạng thái camera chạy nền</h2>
        <p class="hint small">
            Mỗi camera đủ điều kiện (đã thêm vào hệ thống, có Nguồn video, chế độ Tự động, đã vẽ vùng) <strong>luôn chạy ngầm</strong>,
            không cần mở trang camera. Ảnh vượt ngưỡng thay đổi được xếp hàng; AI xử lý lần lượt từng việc, việc bạn bấm tay được ưu tiên trước.
        </p>
        <div id="queueSummary" class="hint"></div>
        <div id="queueCameras"></div>
    </section>
</div>

<!-- =============== Dữ liệu — biến MC (mỗi biến đếm 1 trạng thái trên các vị trí đỗ được chỉ định) =============== -->
<div id="dataTab" class="sys-tab-panel">
<section class="panel">
    <h2>Dữ liệu MC — biến tổng hợp từ vị trí đỗ của camera</h2>
    <div class="hint small" style="margin-top:0">
        Mỗi <b>biến MC</b> chỉ đếm <b>một trạng thái</b> — <b>Còn trống</b>, <b>Đã đỗ</b> hoặc <b>Lỗi</b> — trên các <b>vị trí đỗ</b> (vùng nhận diện khoanh trên ảnh camera, tab 🎯 Vị trí đỗ) bạn chỉ định.
        Chỉ cần <b>1 biến</b> cho cả nhóm vị trí; cần đếm riêng (theo khu, theo tầng…) hoặc đếm trạng thái khác thì tạo thêm biến.
        Giá trị cập nhật theo trạng thái ô đỗ thật; biến được lưu lại khi tắt/mở chương trình.
    </div>

    <div class="tg-toolbar">
        <button id="mcAdd" class="btn primary btn-sm"><span class="ico">➕</span> Thêm biến</button>
        <button id="mcEdit" class="btn secondary btn-sm" disabled><span class="ico">✏️</span> Sửa</button>
        <button id="mcDel" class="btn secondary btn-sm" disabled><span class="ico">🗑️</span> Xoá</button>
        <span id="mcState" class="hint small" style="margin:0"></span>
    </div>

    <div id="mcForm" class="tg-form" style="display:none;">
        <h3 id="mcFormTitle" class="tg-form-title"></h3>
        <div class="tg-form-grid">
            <div class="prop-field" style="grid-column:1/-1"><label for="McCount">Đếm trạng thái</label>
                <div class="dv-state-row">
                    <select id="McCount" style="min-width:270px">
                        <option value="">— Chưa chọn —</option>
                        <option value="Free">Còn trống (Có chỗ đỗ)</option>
                        <option value="Occupied">Đã đỗ (Không có chỗ đỗ)</option>
                        <option value="Error">Lỗi</option>
                    </select>
                    <div class="dv-legend" id="mcLegend">
                        <span data-st="Free"><i class="dv-sw s0"></i>Còn trống (Có chỗ đỗ)</span>
                        <span data-st="Occupied"><i class="dv-sw s1"></i>Đã đỗ (Không có chỗ đỗ)</span>
                        <span data-st="Error"><i class="dv-sw s2"></i>Lỗi</span>
                        <span><i class="dv-sw np"></i>Không chọn</span>
                    </div>
                </div></div>
            <div class="prop-field" style="grid-column:1/-1"><label for="McDesc">Mô tả</label><input id="McDesc" type="text" maxlength="200" /></div>
        </div>

        <div class="sn-sub"><b>Chọn các vị trí đỗ được đếm</b> — lọc camera theo <b>tầng / Zone</b> hoặc tìm theo IP / hãng, bấm camera để xem các vị trí của nó.
            Nút <b>Chọn tất cả (đang lọc)</b> chọn mọi vị trí của các camera đang hiện (ví dụ cả một Zone). Trong lưới: bấm ô, kéo chuột, hoặc bấm một ô rồi giữ <b>Shift</b> + bấm ô khác để chọn/bỏ cả đoạn.</div>
        <div class="mc-filter">
            <label>Tầng <select id="McFloor"></select></label>
            <label>Zone <select id="McZone"></select></label>
            <input id="McSearch" type="search" placeholder="🔍 Tìm theo IP / hãng camera…" autocomplete="off" spellcheck="false" />
            <label class="mc-only"><input type="checkbox" id="McOnly" /> Chỉ camera đã chọn</label>
            <button id="McSelAll" class="btn secondary btn-sm" type="button">Chọn tất cả (đang lọc)</button>
