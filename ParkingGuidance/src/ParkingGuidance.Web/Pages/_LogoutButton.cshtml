@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using ParkingGuidance.Web.Services.Licensing
@if (User.Identity?.IsAuthenticated == true)
{
    // 4 loại tài khoản (AccessLevel): 0 = DEV, 1 = Lic, 2 = Megatech (admin), 3 = User
    var level = AccessLevel.Of(User);
    var (icon, roleKey, roleVi) = level switch
    {
        AccessLevel.Dev   => ("💻", "acc.dev",   "Nhà phát triển"),
        AccessLevel.Lic   => ("🎫", "acc.lic",   "Cấp giấy phép"),
        AccessLevel.Admin => ("🛡️", "acc.admin", "Quản trị viên"),
        _                 => ("👤", "acc.user",  "Người dùng")
    };
    <div class="sidebar-footer">
        <div class="account-row">
            <div class="account-avatar lvl-@level" aria-hidden="true">@icon</div>
            <div class="account-info">
                <div class="account-name">@User.Identity.Name</div>
                <div class="account-role" data-i18n="@roleKey">@roleVi</div>
            </div>
        </div>
        <form method="post" asp-page="/Login" asp-page-handler="Logout" class="account-logout-form">
            <button type="submit" class="account-logout-btn">
                <span aria-hidden="true">↪️</span> <span data-i18n="acc.logout">Đăng xuất</span>
            </button>
        </form>
    </div>
}
