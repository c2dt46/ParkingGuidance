@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@if (User.Identity?.IsAuthenticated == true)
{
    <form method="post" asp-page="/Login" asp-page-handler="Logout" class="pgs-logout">
        <span class="pgs-logout-name">@User.Identity.Name</span>
        <button type="submit" class="pgs-logout-btn">Đăng xuất</button>
    </form>
}

<style>
    .pgs-logout { display: inline-flex; align-items: center; gap: 10px; margin: 0; }
    .pgs-logout-name { opacity: .75; font-size: 14px; }
    .pgs-logout-btn {
        padding: 6px 14px; border-radius: 4px; cursor: pointer;
        border: 1px solid currentColor; background: transparent; color: inherit;
        font: inherit; font-size: 14px;
    }
    .pgs-logout-btn:hover { background: rgba(127,127,127,.18); }
    .pgs-logout-btn:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
</style>
