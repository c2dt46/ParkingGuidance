{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Detection": {
    "ModelPath": "models/yolo11n.onnx",
    "IncludeMotorcycle": false,
    "Threads": 0,
    "IntervalSeconds": 2,
    "ConfidenceThreshold": 0.25,
    "DefaultMotionThresholdPercent": 4.0,
    "OpenTimeoutSeconds": 8,
    "FrameReadTimeoutSeconds": 5,
    "MaxRetryBackoffSeconds": 60
  },

  "Anpr": {
    "TessDataPath": "tessdata",
    "DetectorModelPath": "models/plate_detector.onnx",
    "OcrModelPath": "models/plate_ocr.onnx",
    "UseCnn": true,
    "RelaxedSearch": true,
    "MaxRecognizeMs": 8000,
    "QuickMaxMs": 2500,
    "CharCnnModelPath": "models/char_cnn.onnx",
    "CharDetModelPath": "models/char_det.onnx",
    "PlateCfgPath": "models/plate/yolov3-tiny.cfg",
    "PlateWeightsPath": "models/plate/yolov3-tiny_15000.weights",
    "OcrCharset": "0123456789ABCDEFGHKLMNPRSTUVXYZ",
    "OcrBlankLast": false,
    "OcrNormalize": "signed",
    "DebugDir": "D:/anpr-debug",
    "DebugAll": true
  },

  "VehicleTrainer": {
    "Script": "",
    "Python": "",
    "BaseWeights": "yolo11n.pt",
    "Epochs": 30,
    "ImgSize": 640,
    "Device": "cpu",
    "Batch": 8,
    "Threads": 0
  },

  "PlateTrainer": {
    "Script": "",
    "Python": "",
    "BaseWeights": "yolo11n.pt",
    "Epochs": 40,
    "ImgSize": 640,
    "Device": "cpu",
    "Batch": 8,
    "Threads": 0
  },

  "Trainer": {
    "Path": "",
    "Python": "",
    "Epochs": 25,
    "Threads": 0
  },

  "Led": {
    "Driver": "Auto",
    "BridgePath": "led-bridge/ParkingGuidance.LedBridge.exe",
    "DebounceMs": 400,
    "MinIntervalMs": 1000,
    "PollMs": 1000,
    "ResyncMinutes": 0,
    "MaxBackoffSeconds": 300,
    "RequestTimeoutSeconds": 15,
    "StartupDelaySeconds": 3,
    "PrecheckPing": true,
    "PingTimeoutMs": 800
  },

  "Tags": {
    "SystemEnabled": true,
    "BlinkSlowMs": 1000,
    "BlinkFastMs": 250
  },

  "Persistence": {
    "DataPath": ""
  }
}
