<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ParkingGuidance.Web</RootNamespace>
    <UserSecretsId>parking-guidance-web</UserSecretsId>
    <!-- led-bridge\ chua ban publish cua ParkingGuidance.LedBridge (x86): khong de cac file cua no lot vao glob mac dinh -->
    <DefaultItemExcludes>$(DefaultItemExcludes);led-bridge\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Chay model nhan dien xe YOLOv8 dang ONNX -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.18.0" />

    <!-- Xu ly anh / doc video / webcam -->
    <PackageReference Include="OpenCvSharp4" Version="4.9.0.20240103" />
    <!-- Chon 1 trong cac runtime package theo he dieu hanh se chay:
         OpenCvSharp4.runtime.win (Windows) hoac OpenCvSharp4.runtime.ubuntu.22.04-x64 (Linux) -->
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.9.0.20240103" />

    <!-- Doc so seri o cung / main / card mang (WMI) cho tinh nang Giay phep -->
    <PackageReference Include="System.Management" Version="8.0.0" />

    <!-- OCR doc bien so xe -->
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sao chep model/tessdata/samples ra thu muc build -->
    <Content Include="models\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="tessdata\**" CopyToOutputDirectory="PreserveNewest" />

    <!-- Tien trinh phu x86 goi HDSDK.dll cho bang LED (tao bang tools\build-led-bridge.cmd). Khong co thi LED chay che do mo phong. -->
    <Content Include="led-bridge\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
